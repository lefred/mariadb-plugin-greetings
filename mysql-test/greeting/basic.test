--echo #
--echo # GREETING() returns the message set in greeting_config_file
--echo #

let $conf= $MYSQLTEST_VARDIR/tmp/greeting.conf;

--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT @@greeting_config_file;

--write_file $conf
# A comment, then a blank line

other = ignored
message = Hello, Marina!
EOF
SELECT GREETING();

--echo # The file is read on every call
--remove_file $conf
--write_file $conf
message = "  quoted, with spaces  "
EOF
SELECT CONCAT('[', GREETING(), ']');

--echo # No message: NULL and a warning
--remove_file $conf
--write_file $conf
# nothing here
EOF
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT GREETING();

--echo # A line that is not key = value
--remove_file $conf
--write_file $conf
message
EOF
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT GREETING();

--echo # No file
--remove_file $conf
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
SELECT GREETING();

--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT GREETING('x');

--error ER_GENERATED_COLUMN_FUNCTION_IS_NOT_ALLOWED
CREATE TABLE t1 (a INT, b VARCHAR(100) AS (GREETING()) STORED);
